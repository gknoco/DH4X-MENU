# Copie para .env e ajuste os valores
PORT=3000
NODE_ENV=development

# Credenciais do painel /admin
ADMIN_USER=owner
ADMIN_PASS=troque-esta-senha-forte

# Segredo do JWT (mín. 32 caracteres). Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Caminho do banco SQLite
DB_PATH=./data/ln-aux.db

# Origens permitidas no CORS (separe por vírgula) ou * para todas
CORS_ORIGIN=*

# Atrás de proxy/Cloudflare/Render/Railway? Use 1 para o rate limit enxergar o IP real
TRUST_PROXY=0
